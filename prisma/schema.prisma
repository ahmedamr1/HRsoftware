// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id           String    @id @default(cuid())
  clerkId      String?   @unique
  organizationId String  // Mapping to Clerk Org
  firstName    String
  lastName     String
  email        String    @unique
  role         String
  department   String
  status       String    @default("Active") // Active, On Leave, Terminated, Offboarding
  avatar       String?
  joinedDate   DateTime  @default(now())
  
  // Personal
  dateOfBirth  DateTime?
  gender       String?
  maritalStatus String?
  
  // Contact
  phone        String?
  address      String?
  
  // Financial
  bankName     String?
  accountNumber String?
  salary       Float?
  
  // AI & Skills
  skills       String[]  @default([])
  summary      String?   @db.Text // AI generated or manually added bio
  
  // Emergency
  emergencyContactName  String?
  emergencyContactRel   String?
  emergencyContactPhone String?
  
  timeOffRequests TimeOffRequest[]
  contracts       Contract[]
  documents       Document[]
  workflowInstances WorkflowInstance[]
  offboardingRecord OffboardingRecord?
  assets          Asset[]
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([organizationId])
}

model Contract {
  id           String    @id @default(cuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type         String    // Full-time, Part-time, Freelance, etc.
  startDate    DateTime
  endDate      DateTime?
  documentUrl  String?
  status       String    @default("Active") // Active, Expired, Terminated
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([employeeId])
}

model Document {
  id           String    @id @default(cuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name         String
  type         String    // ID, Resume, Certificate, etc.
  url          String
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([employeeId])
}

model TimeOffRequest {
  id           String    @id @default(cuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id])
  type         String    // Vacation, Sick Leave, etc.
  startDate    DateTime
  endDate      DateTime
  days         Int
  status       String    @default("Pending") // Pending, Approved, Rejected
  reason       String?
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([employeeId])
}

model Job {
  id           String    @id @default(cuid())
  organizationId String
  title        String
  department   String
  location     String
  type         String    // Full-time, Part-time, Contract
  status       String    @default("Open") // Open, Closed, Draft
  description  String?
  
  candidates   Candidate[]
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([organizationId])
}

model Candidate {
  id           String    @id @default(cuid())
  jobId        String
  job          Job       @relation(fields: [jobId], references: [id])
  firstName    String
  lastName     String
  email        String
  phone        String?
  resumeUrl    String?
  status       String    @default("Screening") // Screening, Interview, Offered, Rejected, Hired
  aiScore      Int?      // Score from 0-100 generated by AI
  aiSummary    String?   // AI feedback on the resume
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([jobId])
}

model Workflow {
  id          String         @id @default(cuid())
  organizationId String
  name        String
  description String?
  type        String         // ONBOARDING, OFFBOARDING
  tasks       WorkflowTask[]
  instances   WorkflowInstance[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([organizationId])
}

model WorkflowTask {
  id          String   @id @default(cuid())
  workflowId  String
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  title       String
  description String?
  role        String   @default("Employee") // HR, IT, Manager, Employee
  order       Int      @default(0)

  @@index([workflowId])
}

model WorkflowInstance {
  id          String   @id @default(cuid())
  workflowId  String
  workflow    Workflow @relation(fields: [workflowId], references: [id])
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  status      String   @default("In Progress") // In Progress, Completed
  tasks       WorkflowInstanceTask[]
  offboardingRecord OffboardingRecord?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workflowId])
  @@index([employeeId])
}

model WorkflowInstanceTask {
  id          String           @id @default(cuid())
  instanceId  String
  instance    WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  title       String
  description String?
  role        String
  isCompleted Boolean          @default(false)
  completedAt DateTime?
  completedBy String?          // Clerk ID or name

  @@index([instanceId])
}

model Asset {
  id          String    @id @default(cuid())
  organizationId String
  name        String
  brand       String?
  serialNumber String?
  category    String    // Laptop, Phone, Keys, Badge
  notes       String?
  employeeId  String?
  employee    Employee? @relation(fields: [employeeId], references: [id])
  status      String    @default("In Inventory") // In Inventory, Assigned, Damaged, Lost
  assignedAt  DateTime?
  returnedAt  DateTime?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([organizationId])
  @@index([employeeId])
}

model OffboardingRecord {
  id                String   @id @default(cuid())
  employeeId        String   @unique
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  organizationId    String
  
  // Timeline
  resignationDate   DateTime @default(now())
  lastWorkingDay    DateTime
  status            String   @default("Draft") // Draft, In Progress, Completed
  
  // Details
  reason            String?
  needBackfill      Boolean  @default(false)
  handoverToId      String?
  ownerId           String?  // The HR/Manager handling this
  
  // Financial
  salaryAtExit      Float?
  deductions        Float?
  leavePayout       Float?
  eosBenefits       Float?
  totalSettlement   Float?
  
  // HR/Legal Documents
  resignationLetterUrl String?
  experienceLetterUrl  String?
  exitInterviewUrl     String?
  
  // Links to Workflow
  workflowInstanceId String? @unique
  workflowInstance   WorkflowInstance? @relation(fields: [workflowInstanceId], references: [id], onDelete: SetNull)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([organizationId])
  @@index([employeeId])
}
